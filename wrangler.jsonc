{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jian-bing-liu",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jian-bing-liu"
    }
  ],
  "d1_databases": [
    {
      "binding": "MENU_DB",
      "database_name": "jian-bing-liu-menu",
      "database_id": "b3cd1570-275f-4722-be99-a8cd56b9d7f2",
      "migrations_dir": "migrations"
    }
  ],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "MENU_IMAGES",
      "bucket_name": "jian-bing-liu-images"
    }
  ],
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://jianbingliu.uk",
    "CF_ACCESS_TEAM_DOMAIN": "https://damp-term-ad92.cloudflareaccess.com",
    "CF_ACCESS_AUD": "59c8e79a7ee85433b4dbac768acd6aa9c3403e6fedd55811b3d9519c27170dff",
    "ADMIN_ALLOWED_EMAILS": "ryan.wang345@gmail.com,leahinuk@yahoo.co.uk",
    "RESEND_FROM_EMAIL": "Jian Bing Liu 煎饼刘 <info@jianbingliu.uk>"
  },
  "observability": {
    "enabled": true
  }
}
