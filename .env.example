# Public site URL used for canonical metadata, Open Graph previews, and structured data.
NEXT_PUBLIC_SITE_URL=https://jianbingliu.uk

# Optional: Google Places API (New) key for live Google rating & latest positive reviews (cached 1h).
# If omitted, the site gracefully uses the verified reviews dataset in src/data/reviews.ts.
GOOGLE_PLACES_API_KEY=

# Optional: Explicit Google Place ID for Jian Bing Liu (auto-resolved via Text Search if left blank).
GOOGLE_PLACE_ID=

# Optional: External JSON feed URL for adding new Instagram/TikTok/Google reviews without redeploying.
REVIEWS_FEED_URL=
